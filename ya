## **Шаг 5. Создаём KafkaProducer**

В папке `Kafka` создай класс `KafkaProducer.cs`.

Вставь:

```

using Confluent.Kafka;
using System.Text.Json;
using UserService2.Models;

namespace UserService2.Kafka;

public class KafkaProducer : IDisposable
{
    private readonly IProducer<string, string> _producer;

    public KafkaProducer()
    {
        var config = new ProducerConfig
        {
            BootstrapServers = "10.9.2.80:9092"
        };

        _producer = new ProducerBuilder<string, string>(
            config
        ).Build();
    }

    public async Task RegisterUser(User user)
    {
        string json = JsonSerializer.Serialize(user);

        var result = await _producer.ProduceAsync(
            "user.registered",
            new Message<string, string>
            {
                Key = user.Id.ToString(),
                Value = json
            });

        Console.WriteLine(
            $"Отправлено в Kafka: {result.TopicPartitionOffset}"
        );
    }

    public void Dispose()
    {
        _producer.Dispose();
    }
}

```

Это Producer. Он отправляет зарегистрированных пользователей в Kafka.

## **Шаг 6. Создаём KafkaConsumer**

В папке `Kafka` создай `KafkaConsumer.cs`.

```

using Confluent.Kafka;

namespace UserService2.Kafka;

public class KafkaConsumer : BackgroundService
{
    protected override Task ExecuteAsync(
        CancellationToken stoppingToken)
    {
        return Task.Run(() =>
        {
            var config = new ConsumerConfig
            {
                BootstrapServers = "10.9.2.80:9092",
                GroupId = "user-group-2",
                AutoOffsetReset = AutoOffsetReset.Earliest,
                EnableAutoCommit = false
            };

            using var consumer =
                new ConsumerBuilder<string, string>(config).Build();

            consumer.Subscribe("order.created");

            Console.WriteLine(
                "Ожидание сообщений из order.created..."
            );

            try
            {
                while (!stoppingToken.IsCancellationRequested)
                {
                    var result = consumer.Consume(stoppingToken);

                    Console.WriteLine("Получен заказ:");
                    Console.WriteLine(result.Message.Value);

                    consumer.Commit(result);
                }
            }
            catch (OperationCanceledException)
            {
                Console.WriteLine("Consumer остановлен");
            }
            finally
            {
                consumer.Close();
            }
        }, stoppingToken);
    }
}

```

Теперь Consumer будет ждать сообщения от сервиса заказов.

